rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function prof() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function hasProf() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function isStaff() { return hasProf() && prof().role in ['staff','admin']; }
    function isAdmin() { return hasProf() && prof().role == 'admin'; }

    // Staff profiles. There is NO self sign-up: only an admin creates these, and an
    // account with no profile here (or role 'disabled') can read and write nothing.
    // The very first admin profile is added by hand in the Firebase console.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Store details, app mode, and the editable dropdown lists (locations, units, GST %, payment modes).
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Products: admin full control; staff may only change stock fields.
    match /products/{id} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty','updatedAt','updatedBy']));
    }

    // Product photos (stored separately so the product list stays fast).
    match /productImages/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /sales/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAdmin();
    }
    match /movements/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
    }
    // Shared counters for invoice numbers and in-store barcodes.
    match /counters/{id} {
      allow read, write: if isStaff();
    }
  }
}
